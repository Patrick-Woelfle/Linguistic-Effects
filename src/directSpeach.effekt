module speaker

import src/sentence

interface Speaker[L] {
  def speaker(): S[L]
}

def said(speaker: S[Ls]){spoken: {Speaker[Ls]} => S[Ls] / {Speaker[Ls]}}: S[Ls] = {
  try {
    speaker.says(spoken{capSpeaker})
  } with capSpeaker: Speaker[Ls] {
    def speaker() = {
      resume(speaker)
    }
  }
}

def said(speaker: S[Ls]){spoken: () => S[Ls] / {Speaker[Ls]}}: S[Ls] = {
  said(speaker){ {_} => spoken()}
}

// Helper Definitions
def me() = do speaker[Ls]()
def i() = do speaker[Ls]()

