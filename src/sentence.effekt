module sentence


type Sentence {
  Say(speaker: Sentence, sentence: Sentence)
  Saw(watcher: Sentence, watchted: Sentence)
  Father(of: Sentence)
  Mother(of: Sentence)
  Man()
  Woman()
  OpinionOf(person1: Sentence, person2: Sentence)
  Respects(person1: Sentence, person2: Sentence)
  Is(person: Sentence, predicate: Sentence)
  ForAll(individual: Sentence, s: Sentence)
  Exists(individual: Sentence, s: Sentence)
  Implies(a: Sentence, b: Sentence)
  Person(name: String)
  InLoveWith(person: Sentence)
  Present(giver: Sentence, receiver: Sentence)
  And(sentence1: Sentence, sentence2: Sentence)
  Empty()
  Likes(person1: Sentence, person2: Sentence)
}

