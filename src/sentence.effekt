module playground

type Sentence[L] {
  Proposition3(label: L, argument1: Sentence[L], argument2: Sentence[L], argument3: Sentence[L])
  Proposition2(label: L, argument1: Sentence[L], argument2: Sentence[L])
  Proposition1(label: L, argument1: Sentence[L])
  Proposition0(label: L)
  Term3(label: L, argument1: Sentence[L], argument2: Sentence[L], argument3: Sentence[L])
  Term2(label: L, argument1: Sentence[L], argument2: Sentence[L])
  Term1(label: L, argument1: Sentence[L])
  Term0(label: L)
  Quantifier(label: L, argument1: Sentence[L])
  Empty()
}

type Ls {
  // Propositions
  Loves()
  Say()
  Saw()
  Man()
  Woman()
  Respects()
  Implies()
  InLoveWith()
  Present()
  AndP()
  Likes()
  True()
  False()
  // Terms
  Father()
  Mother()
  OpinionOf()
  Person()
  Nothing()
  AndT()
  Bob()
  John()
  Alice()
  Identifier(string: String)
  // Quantifiers
  Exists()
  ForAll()
}


def loves(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Loves(), arg1, arg2)
}

def says(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Say(), arg1, arg2)
}

def saw(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Saw(), arg1, arg2)
}

def man(arg1: Sentence[Ls]) = {
  Proposition1(Man(), arg1)
}

def woman(arg1: Sentence[Ls]) = {
  Proposition1(Woman(), arg1)
}

def respects(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Saw(), arg1, arg2)
}

def implies(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Implies(), arg1, arg2)
}

def andP(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(AndP(), arg1, arg2)
}

def InLoveWith(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(InLoveWith(), arg1, arg2)
}

def Likes(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Proposition2(Likes(), arg1, arg2)
}

def true_(): Sentence[Ls] = {
  Proposition0(True())
}

def false_(): Sentence[Ls] = {
  Proposition0(False())
}

def father(arg1: Sentence[Ls]) = {
  Term1(Father(), arg1)
}

def mother(arg1: Sentence[Ls]) = {
  Term1(Mother(), arg1)
}

def opinionOf(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Term2(OpinionOf(), arg1, arg2)
}

def person(name: String): Sentence[Ls] = {
  Term0(Person())
}

val john: Sentence[Ls] = {
  Term0(John())
}

val bob: Sentence[Ls] = {
  Term0(Bob())
}

val alice: Sentence[Ls] = {
  Term0(Alice())
}

val nothing: Sentence[Ls] = {
  Term0(Nothing())
}

def identifier(string: String): Sentence[Ls] = {
  Term0(Identifier(string))
}

def andT(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  Term2(AndT(), arg1, arg2)
}

def forall(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Quantifier(ForAll(), arg1)
}

def exists(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Quantifier(Exists(), arg1)
}

def present(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Term2(Present(), arg1, arg2)
}


def getLabel(s: Sentence[Ls]): Ls  = {
  s match {
    case Proposition3(l, arg1, arg2, arg3) => l
    case Proposition2(l, arg1, arg2) => l
    case Proposition1(l, arg1) => l
    case Proposition0(l) => l
    case Term3(l, arg1, arg2, arg3) => l
    case Term2(l, arg1, arg2) => l
    case Term1(l, arg1) => l
    case Term0(l) => l
    case Quantifier(l, arg1) => l
    case Empty() => Nothing()
  }
}

def combine(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  arg2 match {
    case Proposition2(label, argument1, argument2) => Proposition2(label, combine(arg1, argument1), combine(arg1, argument2))
    case Proposition1(label, argument1) => Proposition1(label, combine(arg1, argument1))
    case Proposition3(label, argument1, argument2, argument3) => Proposition3(label, combine(arg1, argument1), combine(arg1, argument2), combine(arg1, argument3))
    case Proposition0(label) => Proposition0(label)
    case Term3(label, argument1, argument2, argument3) => Term3(label, combine(arg1, argument1), combine(arg1, argument2), combine(arg1, argument3))
    case Term2(label, argument1, argument2) => Term2(label, combine(arg1, argument1), combine(arg1, argument2))
    case Term1(label, argument1) => Term1(label, combine(arg1, argument1))
    case Term0(label) => Term0(label)
    case Quantifier(label, argument1) => Quantifier(label, combine(arg1, argument1))
    case Empty() => arg1
  }
}