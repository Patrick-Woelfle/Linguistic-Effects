module sentence


// Delete Prop0 and Term0
// Rework Questions to work with immediate answer
type Sentence[L] {
  Prop3(label: L, argument1: Sentence[L], argument2: Sentence[L], argument3: Sentence[L])
  Prop2(label: L, argument1: Sentence[L], argument2: Sentence[L])
  Prop1(label: L, argument1: Sentence[L])
  Prop0(label: L)
  Term3(label: L, argument1: Sentence[L], argument2: Sentence[L], argument3: Sentence[L])
  Term2(label: L, argument1: Sentence[L], argument2: Sentence[L])
  Term1(label: L, argument1: Sentence[L])
  Term0(label: L)
  Quantifier(label: L, argument1: Sentence[L], argument2: Sentence[L])
  Question1(whPhrase: Sentence[L], question: Sentence[L])
  Question2(question: {() => Sentence[L]} => Sentence[L] at {})
  Empty()
}

type Ls {
  // Props
  Loves()
  Says()
  Saw()
  Man()
  Woman()
  Respects()
  Implies()
  InLoveWith()
  Present()
  And()
  Or()
  Likes()
  True()
  False()
  // Terms
  Father()
  Mother()
  OpinionOf()
  Person()
  Nothing()
  Bob()
  John()
  Alice()
  Identifier(string: String)
  // Quantifiers
  Exists()
  ForAll()
  // Effektful
  Someone()
  Everyone()
  He()
  She()
  Her()
  His()
  Who()
  Trace()
  Pronoun()
}


def loves(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Loves(), arg1, arg2)
}

def says(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Says(), arg1, arg2)
}

def saw(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Saw(), arg1, arg2)
}

def man(arg1: Sentence[Ls]) = {
  Prop1(Man(), arg1)
}

def woman(arg1: Sentence[Ls]) = {
  Prop1(Woman(), arg1)
}

def respects(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Saw(), arg1, arg2)
}

def implies(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Implies(), arg1, arg2)
}

def andP(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(And(), arg1, arg2)
}

def inLoveWith(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(InLoveWith(), arg1, arg2)
}

def likes(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Prop2(Likes(), arg1, arg2)
}

def true_(): Sentence[Ls] = {
  Prop0(True())
}

def false_(): Sentence[Ls] = {
  Prop0(False())
}

def father(arg1: Sentence[Ls]) = {
  Term1(Father(), arg1)
}

def mother(arg1: Sentence[Ls]) = {
  Term1(Mother(), arg1)
}

def opinionOf(arg1: Sentence[Ls], arg2: Sentence[Ls]) = {
  Term2(OpinionOf(), arg1, arg2)
}

def person(name: String): Sentence[Ls] = {
  Term0(Person())
}

val john: Sentence[Ls] = {
  Term0(John())
}

val bob: Sentence[Ls] = {
  Term0(Bob())
}

val alice: Sentence[Ls] = {
  Term0(Alice())
}

val nothing: Sentence[Ls] = {
  Term0(Nothing())
}

def identifier(string: String): Sentence[Ls] = {
  Term0(Identifier(string))
}

def andT(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  Term2(And(), arg1, arg2)
}

def forall(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  Quantifier(ForAll(), arg1, arg2)
}

def exists(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  Quantifier(Exists(), arg1, arg2)
}

def present(arg1: Sentence[Ls], arg2: Sentence[Ls]): Sentence[Ls] = {
  Term2(Present(), arg1, arg2)
}


