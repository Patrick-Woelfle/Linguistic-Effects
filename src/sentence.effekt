module sentence


// Delete Prop0 and Term0
// Rework Questions to work with immediate answer
type S[L] {
  Prop3(label: L, argument1: S[L], argument2: S[L], argument3: S[L])
  Prop2(label: L, argument1: S[L], argument2: S[L])
  Prop1(label: L, argument1: S[L])
  Prop0(label: L)
  Term3(label: L, argument1: S[L], argument2: S[L], argument3: S[L])
  Term2(label: L, argument1: S[L], argument2: S[L])
  Term1(label: L, argument1: S[L])
  Term0(label: L)
  Quantifier(label: L, argument1: S[L], argument2: S[L])
  Question1(whPhrase: S[L], question: S[L])
  Question2(question: {() => S[L]} => S[L] at {})
  Unknown()
}

type Ls {
  // Props
  Loves()
  Says()
  Saw()
  Respects()
  Implies()
  InLoveWith()
  Present()
  And()
  Or()
  Likes()
  Is()
  True()
  False()
  // Terms
  Man()
  Woman()
  Father()
  Mother()
  OpinionOf()
  Person()
  Nothing()
  Bob()
  John()
  Alice()
  Identifier(string: String)
  // Quantifiers
  Exists()
  ForAll()
  // Effektful
  Someone()
  Everyone()
  He()
  She()
  Her()
  His()
  Who()
  Trace()
  Pronoun()
}


def loves(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Loves(), arg1, arg2)
}

def says(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Says(), arg1, arg2)
}

def saw(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Saw(), arg1, arg2)
}

def respects(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Saw(), arg1, arg2)
}

def implies(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Implies(), arg1, arg2)
}

def andP(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(And(), arg1, arg2)
}

def inLoveWith(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(InLoveWith(), arg1, arg2)
}

def likes(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Likes(), arg1, arg2)
}

def is_(arg1: S[Ls], arg2: S[Ls]) = {
  Prop2(Is(), arg1, arg2)
}

def true_(): S[Ls] = {
  Prop0(True())
}

def false_(): S[Ls] = {
  Prop0(False())
}

def man() = {
  Term0(Man())
}

def woman() = {
  Term0(Woman())
}

def father(arg1: S[Ls]) = {
  Term1(Father(), arg1)
}

def mother(arg1: S[Ls]) = {
  Term1(Mother(), arg1)
}

def opinionOf(arg1: S[Ls], arg2: S[Ls]) = {
  Term2(OpinionOf(), arg1, arg2)
}

def person(name: String): S[Ls] = {
  Term0(Person())
}

def john(): S[Ls] = {
  Term0(John())
}

def bob(): S[Ls] = {
  Term0(Bob())
}

def alice(): S[Ls] = {
  Term0(Alice())
}

def nothing(): S[Ls] = {
  Term0(Nothing())
}

def identifier(string: String): S[Ls] = {
  Term0(Identifier(string))
}

def andT(arg1: S[Ls], arg2: S[Ls]): S[Ls] = {
  Term2(And(), arg1, arg2)
}

def forall(arg1: S[Ls], arg2: S[Ls]): S[Ls] = {
  Quantifier(ForAll(), arg1, arg2)
}

def exists(arg1: S[Ls], arg2: S[Ls]): S[Ls] = {
  Quantifier(Exists(), arg1, arg2)
}

def present(arg1: S[Ls], arg2: S[Ls]): S[Ls] = {
  Term2(Present(), arg1, arg2)
}


