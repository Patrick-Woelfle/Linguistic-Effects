// Helper Definitions
def loves(lover: Sentence, loved: Sentence): Sentence = Is(lover, InLoveWith(loved))
def respects(respecter: Sentence, respected: Sentence): Sentence = Respects(respecter, respected)
def says(speaker: Sentence, sentence: Sentence): Sentence = Say(speaker, sentence)
def saw(watcher: Sentence, watched: Sentence): Sentence = Saw(watcher, watched)
def mother(of: Sentence): Sentence = Mother(of)
def present(giver: Sentence, receiver: Sentence): Sentence = Present(giver, receiver)
val alice = Person("Alice")
val john = Person("John")
val bob = Person("Bob")


