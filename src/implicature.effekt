module implicature

import src/sentence


interface Implicature {
  def add(sentence1: Sentence[Ls], sentence2: Sentence[Ls]): Sentence[Ls]
  def assume(sentence1: Sentence[Ls]): Sentence[Ls]
  def is_(sentence1: Sentence[Ls], sentence2: Sentence[Ls]): Sentence[Ls]
}

def implicatureBoundary { body: {Implicature} => Sentence[Ls] / Implicature}: Sentence[Ls] = {
  try {
    body{cap}
  } with cap: Implicature {
    def add(sentence1: Sentence[Ls], sentence2: Sentence[Ls]) = {
      andP(resume(sentence1), sentence2)
    } 
    def assume(sentence1: Sentence[Ls]) = {
      exists(sentence1, resume(sentence1))
    }
    def is_(sentence1: Sentence[Ls], predicate: Sentence[Ls]) = {
      andP(resume(sentence1), combine(sentence1, predicate))
    }
  }
}
 

def implicatureBoundary { body: => Sentence[Ls] / Implicature}: Sentence[Ls] = {
  implicatureBoundary{ {_} => body()}
}

// Helper Definitions
def whoIs(sentence1: Sentence[Ls], sentence2: Sentence[Ls]) = do add(sentence1, sentence2)
def assume(sentence1: Sentence[Ls]) = do assume(sentence1)
def is_(sentence1: Sentence[Ls], predicate: Sentence[Ls]) = do is_(sentence1, predicate)


// --- Examples that work ---

val johnLovesBobWhoIsAlicesFather: Sentence[Ls] = implicatureBoundary {
  john.loves(whoIs(bob, father(alice)))
}


