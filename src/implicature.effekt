module implicature

import src/sentence


interface Implicature {
  def add(sentence1: Sentence, sentence2: Sentence): Sentence
  def assume(sentence1: Sentence): Sentence
  def is_(sentence1: Sentence, predicate: Sentence): Sentence
}

def implicatureBoundary{ body: {Implicature} => Sentence / Implicature}: Sentence = {
  try {
    body{cap}
  } with cap: Implicature {
    def add(sentence1: Sentence, sentence2: Sentence) = {
      And(resume(sentence1), sentence2)
    } 
    def assume(sentence1: Sentence) = {
      Exists(sentence1, resume(sentence1))
    }
    def is_(sentence1: Sentence, predicate: Sentence) = {
      And(resume(sentence1), Is(sentence1, predicate))
    }
  }
}

def implicatureBoundary { body: => Sentence / Implicature}: Sentence = {
  implicatureBoundary{ {_} => body()}
}

// Helper Definitions
def whoIs(sentence1: Sentence, sentence2: Sentence) = do add(sentence1, sentence2)
def assume(sentence1: Sentence) = do assume(sentence1)
def is_(sentence1: Sentence, predicate: Sentence) = do is_(sentence1, predicate)


// --- Examples that work ---

val johnLovesBobWhoIsAlicesFather: Sentence = implicatureBoundary {
  john.loves(whoIs(bob, Father(alice)))
}


def main(): Unit = {
  println(show(johnLovesBobWhoIsAlicesFather))
}
