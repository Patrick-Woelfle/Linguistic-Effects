module playground

import src/sentence
import src/inputOutput


type Mixed {
  Value(n: Int)
  Computation(f: Mixed => Mixed at {})
}

interface Yield {
  def yield(): Mixed
}

def addToFive(): Mixed = {
  try {
    Value(5).add(do yield())
  } with Yield {
    def yield() = {
      Computation(box { a => resume(a) })
    }
  }
}

def add(n1: Mixed, n2: Mixed): Mixed = {
  n1 match {
    case Value(a) => n2 match {
      case Value(b) => Value(a + b)
      case Computation(f) => <>
    }
    case Computation(f) => <>
  }
}

def getComputation(f: Mixed): Mixed => Mixed at {} = {
  f match {
    case Computation(f) => f
    case _ => <>
  }
}

def getValue(a: Mixed): Int = {
  a match {
    case Value(b) => b
    case _ => <>
  }
}

def main() = {
  println(show(getComputation(addToFive())(Value(1))))
}