module presentation

import src/sentence


interface Quantification {
  def everyone(): Sentence
  def someone(): Sentence
}

def quantificationBoundary(personLabel: String) { body: {Quantification} => Sentence / Quantification}: Sentence = {
  var counter = 0
  def fresh(): Sentence = { val x = Person(personLabel ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification {
    def everyone() = {
      val x = fresh()
      ForAll(x, resume(x))
    }
    def someone() = {
      val x = fresh()
      Exists(x, resume(x))
    }
  }
}

val someoneLovesEveryone1: Sentence = quantificationBoundary("x"){ {outer} =>  
  quantificationBoundary("y") { {inner} =>
      inner.someone().loves(outer.everyone)
  }
}

val someoneLovesEveryone2: Sentence = quantificationBoundary("x"){ {outer} =>  
  quantificationBoundary("y") { {inner} =>
      outer.someone().loves(inner.everyone)
  }
}


def main() = {
  println(show(someoneLovesEveryone1))
  println(show(someoneLovesEveryone2))
}