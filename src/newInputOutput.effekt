module inputOutput

import src/sentence



interface Input {
  def input(): Sentence
}

interface Output{
  def output(a: Sentence): Sentence
}


def inputBoundary{f: () => Sentence / {Input}}: Sentence => Sentence at {f} = box { a =>
  try {
      f()
  } with Input {
    def input() = resume(a)
  }
}


def ioHandler{g: () => Sentence / {Input, Output}}: Sentence = {
  var buffer = Empty()
  try {
    g()
  } with Output {
    def output(a: Sentence) = {
      buffer = a
      resume(a)
    }
  } with Input {
    def input() = {
      resume(buffer)
    }
  }
}

val test = ioHandler {
  Father(do output(john)).loves(Mother(do input()))
}




val test4 = Father(john).loves(Mother(john))



def main(): Unit = {
  println(show(test))
}

