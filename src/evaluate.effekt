module parse

import src/parse
import src/sentence
import src/quantification
import src/prettyPrinter
import map
import io/console
import io


interface EvaluateEffects {
  def lookupTerm(s: Sentence[Ls]): Sentence[Ls]
  def lookupProp(s: Sentence[Ls]): Sentence[Ls]
  def getTerms(): List[Sentence[Ls]]
  def removeFromTerms(s: Sentence[Ls]): Unit
}



def gatherTerms(s: Sentence[Ls]): Sentence[Ls] / {EvaluateEffects} = {
  s match {
    case Prop3(label, arg1, arg2, arg3) => Prop3(label, gatherTerms(arg1), gatherTerms(arg2), gatherTerms(arg3))
    case Prop2(label, arg1, arg2) => Prop2(label, gatherTerms(arg1), gatherTerms(arg2))
    case Prop1(label, arg1) => Prop1(label, gatherTerms(arg1))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => do lookupTerm(s); Term3(label, gatherTerms(arg1), gatherTerms(arg2), gatherTerms(arg3))
    case Term2(label, arg1, arg2) => do lookupTerm(s); Term2(label, gatherTerms(arg1), gatherTerms(arg2))
    case Term1(label, arg1) => do lookupTerm(s); Term1(label, gatherTerms(arg1))
    case Term0(label) => do lookupTerm(s); Term0(label)
    case Quantifier(label, arg1, arg2) => {
      val restOfSentence = gatherTerms(arg2)
      do removeFromTerms(arg1)
      Quantifier(label, arg1, restOfSentence)
    }
    case Question1(whPhrase, question) => Question1(whPhrase, gatherTerms(question))
    case Question2(question) => Question2(question)
    case Empty() => Empty()
  }
}

def removeQuantifiers(s: Sentence[Ls]): Sentence[Ls] / {EvaluateEffects} = {
  s match {
    case Prop3(label, arg1, arg2, arg3) => Prop3(label, removeQuantifiers(arg1), removeQuantifiers(arg2), removeQuantifiers(arg3))
    case Prop2(label, arg1, arg2) => Prop2(label, removeQuantifiers(arg1), removeQuantifiers(arg2))
    case Prop1(label, arg1) => Prop1(label, removeQuantifiers(arg1))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => Term3(label, removeQuantifiers(arg1), removeQuantifiers(arg2), removeQuantifiers(arg3))
    case Term2(label, arg1, arg2) => Term2(label, removeQuantifiers(arg1), removeQuantifiers(arg2))
    case Term1(label, arg1) => Term1(label, removeQuantifiers(arg1))
    case Term0(label) => Term0(label)
    case Quantifier(label, arg1, arg2) => label match {
      case Exists() => {
        val evaluatedArg2 = removeQuantifiers(arg2)
        var terms = do getTerms()
        var allWorlds: List[Sentence[Ls]] = terms.map {x => evaluatedArg2.replace(arg1, x)}
        allWorlds.foldLeft(Prop0(False())){(x, y) => Prop2(Or(), x, y)}
      }
      case ForAll() => {
        val evaluatedArg2 = removeQuantifiers(arg2)
        var terms = do getTerms()
        var allWorlds: List[Sentence[Ls]] = terms.map {x => evaluatedArg2.replace(arg1, x)}
        allWorlds.foldLeft(Prop0(True())){(x, y) => Prop2(And(), x, y)}
      }
      case a => println("found an unexpected Label for a Quantifier: " ++ show(a)); Empty() 
    }
    case Question1(whPhrase, question) => Question1(whPhrase, removeQuantifiers(question))
    case Question2(question) => Question2(question)
    case Empty() => Empty()
  }
}


def replace(sentence: Sentence[Ls], replaced: Sentence[Ls], replacee: Sentence[Ls]): Sentence[Ls] = {
  var stringofSentence = show(sentence)
  var stringOfReplaced = show(replaced)
  sentence match {
    case Prop3(label, arg1, arg2, arg3) => Prop3(label, replace(arg1, replaced, replacee), replace(arg2, replaced, replacee), replace(arg3, replaced, replacee))
    case Prop2(label, arg1, arg2) => Prop2(label, replace(arg1, replaced, replacee), replace(arg2, replaced, replacee))
    case Prop1(label, arg1) => Prop1(label, replace(arg1, replaced, replacee))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => {
      if (stringofSentence == stringOfReplaced) replacee
      else Term3(label, replace(arg1, replaced, replacee), replace(arg2, replaced, replacee), replace(arg3, replaced, replacee))
    }
    case Term2(label, arg1, arg2) => {
      if (stringofSentence == stringOfReplaced) replacee
      else Term2(label, replace(arg1, replaced, replacee), replace(arg2, replaced, replacee))
    }
    case Term1(label, arg1) => {
      if (stringofSentence == stringOfReplaced) replacee
      else Term1(label, replace(arg1, replaced, replacee))
    }
    case Term0(label) => {
      if (stringofSentence == stringOfReplaced) {
        replacee
      }
      else Term0(label)
    }
    case Quantifier(label, arg1, arg2) => Quantifier(label, replace(arg1, replaced, replacee), replace(arg2, replaced, replacee))
    case Question1(whPhrase, question) => Question1(whPhrase, replace(question, replaced, replacee))
    case Question2(question) => Question2(question)
    case Empty() => Empty()
  }
} 

def evaluateHelper(s: Sentence[Ls]): Sentence[Ls] / {EvaluateEffects} = {
  s match {
    case Prop3(label, arg1, arg2, arg3) => do lookupProp(Prop3(label, arg1, arg2, arg3))
    case Prop2(label, arg1, arg2) => label match {
      case And() => sentenceAnd(evaluateHelper(arg1), evaluateHelper(arg2))
      case Or() => sentenceOr(evaluateHelper(arg1), evaluateHelper(arg2))
      case other => do lookupProp(Prop2(label, arg1, arg2))
    }
    case Prop1(label, arg1) => do lookupProp(Prop1(label, arg1))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => Term3(label, evaluateHelper(arg1), evaluateHelper(arg2), evaluateHelper(arg3))
    case Term2(label, arg1, arg2) => Term2(label, evaluateHelper(arg1), evaluateHelper(arg2))
    case Term1(label, arg1) => Term1(label, evaluateHelper(arg1))
    case Term0(label) => Term0(label)
    case Quantifier(label, arg1, arg2) => Quantifier(label, evaluateHelper(arg1), evaluateHelper(arg2))
    case Question1(whPhrase, question) => Question1(whPhrase, evaluateHelper(question))
    case Question2(question) => Question2(question)
    case Empty() => Empty()
  }
}

def sentenceAnd(x: Sentence[Ls], y: Sentence[Ls]): Sentence[Ls] = {
  x match {
    case Prop0(labelX) => {
      y match {
        case Prop0(labelY) => {
          labelX match {
            case True() => {
              labelY match {
                case True() => Prop0(True())
                case False() => Prop0(False())
                case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
              }
            }
            case False() => Prop0(False())
            case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
            }
          }
          case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
        }
      }
    case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
  }
}

def sentenceOr(x: Sentence[Ls], y: Sentence[Ls]): Sentence[Ls] = {
  x match {
    case Prop0(labelX) => {
      y match {
        case Prop0(labelY) => {
          labelX match {
            case False() => {
              labelY match {
                case False() => Prop0(False())
                case True() => Prop0(True())
                case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
              }
            }
            case True() => Prop0(True())
            case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
            }
          }
          case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
        }
      }
    case other => println("Found unexpected argument to and: " ++ show(other)); Prop0(False())
  }
}

def evaluate(s: Sentence[Ls]): Bool = {
  var terms: List[Sentence[Ls]] = Nil()
  var propositions = emptyGeneric[Sentence[Ls], Sentence[Ls]]
  try {
    // println("Original Sentence: \"" ++ sentenceToString(input) ++ "\"")
    // println("Evaluation of Sentence: \"" ++ sentenceToString(evaluationSentence) ++ "\"")
    var sentenceWithoutQuantifiers = removeQuantifiers(gatherTerms(s))
    println("Sentence without quantifiers: \"" ++ sentenceToStringParan(sentenceWithoutQuantifiers) ++ "\"")
    var evaluationSentence = evaluateHelper(sentenceWithoutQuantifiers)
    evaluationSentence match {
      case Prop0(True()) => true
      case Prop0(False()) => false
      case other => println("Unexpected Result: " ++ show(other)); false
    }
  } with EvaluateEffects {
    def lookupTerm(s: Sentence[Ls]) = {
      if (terms.contains(s) {(x, y) => show(x) == show(y)}) {
        resume(s)
      }
      else {
        terms = Cons(s, terms) 
        resume(s)
      }
    }
    def lookupProp(s: Sentence[Ls]) = {
      val result = getOrElse(propositions, s) { () =>
      console {
          do writeLine("No entry for \"" ++ sentenceToString(s) ++ "\" found, is it true or false?")
          val answer = do readLine()
          answer match {
            case "true" => propositions.put(s, Prop0(True())); Prop0(True())
            case other => propositions.put(s, Prop0(False())); Prop0(False())
          }
        }
      }
      resume(result)
    }
    def getTerms() = {
      resume(terms)
    }
    def removeFromTerms(s: Sentence[Ls]) = {
      terms.indexOf(s) {(x, y) => show(x) == show(y)} match {
        case Some(i) => terms = terms.deleteAt(i); resume(())
        case None() => resume(())
      }
    }
  }
}

def main(): Unit  = { 
    var input = parse([Everyone(), Says(), Someone(), Loves(), Bob(), Mother()])
    println(show(evaluate(input)))
}