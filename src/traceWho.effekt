module traceWho

import src/sentence
import src/inputOutput


interface Trace {
  def trace(): S[Ls]
}

interface Who {
  def who(): S[Ls]
}


def traceBoundary{traceSentence: () => S[Ls] / Trace}: {() => S[Ls]} => S[Ls] at {traceSentence} = box { {s} =>
  try {
    traceSentence()
  } with Trace {
    def trace() = { 
      resume(s())
    }
  }
}

def whoBoundary{whoSentence: () => S[Ls] / Who} {traceSentence: () => S[Ls] / Trace}: {() => S[Ls]} => S[Ls] at {whoSentence, traceSentence} = box { {answer} =>
  try {
    (traceBoundary{traceSentence}){whoSentence()}
  } with Who {
    def who() = {
      resume(answer())
    }
  }
}

// Overload
def traceBoundary() {traceSentence: () => S[Ls] / Trace} {answer: () => S[Ls]}: S[Ls] = {
  (traceBoundary{traceSentence}){answer}
}

def whoBoundary{whoSentence: () => S[Ls] / Who} {traceSentence: () => S[Ls] / Trace} {answer: () => S[Ls]}: S[Ls] = {
  (whoBoundary{whoSentence} {traceSentence}){answer}
}

def whoBoundary {answer: () => S[Ls]} {whoSentence: () => S[Ls] / Who} {traceSentence: () => S[Ls] / Trace}: S[Ls] = {
  (whoBoundary{whoSentence} {traceSentence}){answer}
}



// For fronted Who[L]
def who(): S[Ls] / {Who} = do who()
def __(): S[Ls] / {Trace} = do trace()
def whose(): S[Ls] / {Who} = who() 

// For In-Situ Who[L]
def who(): S[Ls] / {Trace} = do trace()


// ---- Examples that Work ----


// Could bind to who[L] or Father
def whoseFatherDidAliceSaySawHisMother(): S[Ls] = ioBoundary {
  whoBoundary {bind(father(who()))} {__().saw(his().mother())} {bob()}
}

// Correctly doesn't connect who[L] with his
def whoDidHisMotherSee(): S[Ls] = ioBoundary { 
  whoBoundary {bind(who())} {his().mother().saw( __())} {bob()}
}

// Could be better with Multiple Levels
def whoSawWho(): S[Ls] = whoBoundary {who()} {__().saw(who())} {bob()}

// To use IO in incomplete Sentences, boxing is necessary
def whoLoveshisMother(): {() => S[Ls]} => S[Ls] / {IO[Ls]} at {} = box { {arg} => whoBoundary{who()} {loves(__(), his().mother)} {arg} }
def bobLovesHisMother(): S[Ls] = ioBoundary { (whoLoveshisMother()){() => bind(bob())}}


// ---- Examples that don't work ----

// Since In-Situ-Who[L] and Trace[L] are implemented the same, Superiority doesn't work correctly
def whoDidWhoSee__(): S[Ls] = whoBoundary {who()} {who().saw(__())} {bob()}

// Doesn't work, because who[L] can't select out of a set of people, interesting because john can bind he
def whichOfJohnsFriendsdoesHeLike__(): S[Ls] = <>



def main() = {
  println("a")
}