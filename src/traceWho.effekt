module traceWho

import src/sentence
import src/inputOutput


interface Trace {
  def trace(): Sentence
}

interface Who {
  def who(): Sentence
}


def traceBoundary{traceSentence: () => Sentence / Trace}: {() => Sentence}  => Sentence at {traceSentence} = box { {s} =>
  try {
    traceSentence()
  } with Trace {
    def trace() = { 
      resume(s())
    }
  }
}

def whoBoundary{whoSentence: () => Sentence / Who} {traceSentence: () => Sentence / Trace}: {() => Sentence} => Sentence at {whoSentence, traceSentence} = box { {answer} =>
  try {
    (traceBoundary{traceSentence}){whoSentence()}
  } with Who {
    def who() = {
      resume(answer())
    }
  }
}

// Overload
def traceBoundary() {traceSentence: () => Sentence / Trace} {answer: () => Sentence}: Sentence = {
  (traceBoundary{traceSentence}){answer}
}

def whoBoundary{whoSentence: () => Sentence / Who} {traceSentence: () => Sentence / Trace} {answer: () => Sentence}: Sentence = {
  (whoBoundary{whoSentence} {traceSentence}){answer}
}



// For fronted Who
def who(): Sentence / {Who} = do who()
def __(): Sentence / {Trace} = do trace() 

// For In-Situ Who
def who(): Sentence / {Trace} = do trace()


// ---- Examples that Work ----

def aliceLoves___(): {() => Sentence} => Sentence at {} = traceBoundary {loves(alice, __())}
def aliceLoves___{answer: () => Sentence}: Sentence = traceBoundary {loves(alice, __())} {answer}
val aliceLovesBob: Sentence = (aliceLoves___()){() => bob}
val aliceLovesJohn: Sentence = aliceLoves___{() => john}

// Second Block argument needs to be applied after first has been evaluated, so that bind and his are evaluated in the same order
val bobLoveshisMother: Sentence = ioBoundary {
  traceBoundary {loves(__(), his().mother)} {bind(bob)}
}

// Correctly doesn't connect her to alice
val herMotherLovesAlice: Sentence = ioBoundary {
  traceBoundary {loves(Mother(her()), __())} {bind(alice)}
}

def WhoDidAliceSee(): {() => Sentence} => Sentence at {} = whoBoundary {who()} {alice.saw(__())}
val aliceSawBob = (WhoDidAliceSee()){() => bob}

// Who can pied-pipe surrounding words
def whoseMotherDoesAliceLove(): {() => Sentence} => Sentence at {} = whoBoundary {who().mother()} {alice.loves(__())} 
val AliceLovesBobsMother = (whoseMotherDoesAliceLove()){() => bob}

def whoSawHisMother(): Sentence = ioBoundary {
  whoBoundary {bind(who())} {__().saw(his().mother())} {() => bob}
}

// Could bind to who or Father
def whoseFatherDidAliceSaySawHisMother(): Sentence = ioBoundary {
  whoBoundary {bind(Father(who()))} {__().saw(his().mother())} {() => bob}
}

// Correctly doesn't connect who with his
def whoDidHisMotherSee(): Sentence = ioBoundary { 
  whoBoundary {bind(who())} {his().mother().saw( __())} {() => bob}
}

// Could be better with Multiple Levels
def whoSawWho(): Sentence = whoBoundary {who()} {__().saw(who())} {() => bob}

// To use IO in incomplete Sentences, boxing is necessary
def whoLoveshisMother(): {() => Sentence} => Sentence / {IO} at {} = box { {arg} => whoBoundary{who()} {loves(__(), his().mother)} {arg} }
def bobLovesHisMother(): Sentence = ioBoundary { (whoLoveshisMother()){() => bind(bob)}}


// ---- Examples that don't work ----

// Since In-Situ-Who and Trace are implemented the same, Superiority doesn't work correctly
// def whoDidWhoSee__(): Sentence = whoBoundary {who()} {who().saw(__())} {() => bob}


def main(): Unit = {
  inspect(bobLovesHisMother())
}