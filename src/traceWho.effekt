module traceWho

import src/sentence
import src/inputOutput


interface Trace[L] {
  def trace(): Sentence[L]
}

interface Who[L] {
  def who(): Sentence[L]
}


def traceBoundary[L]{traceSentence: () => Sentence[L] / Trace[L]}: {() => Sentence[L]}  => Sentence[L] at {traceSentence} = box { {s} =>
  try {
    traceSentence()
  } with Trace[L] {
    def trace() = { 
      resume(s())
    }
  }
}

def whoBoundary[L]{whoSentence: () => Sentence[L] / Who[L]} {traceSentence: () => Sentence[L] / Trace[L]}: {() => Sentence[L]} => Sentence[L] at {whoSentence, traceSentence} = box { {answer} =>
  try {
    (traceBoundary[L]{traceSentence}){whoSentence()}
  } with Who[L] {
    def who() = {
      resume(answer())
    }
  }
}

// Overload
def traceBoundary[L]() {traceSentence: () => Sentence[L] / Trace[L]} {answer: () => Sentence[L]}: Sentence[L] = {
  (traceBoundary[L]{traceSentence}){answer}
}

def whoBoundary[L]{whoSentence: () => Sentence[L] / Who[L]} {traceSentence: () => Sentence[L] / Trace[L]} {answer: () => Sentence[L]}: Sentence[L] = {
  (whoBoundary[L]{whoSentence} {traceSentence}){answer}
}

def whoBoundary[L] {answer: () => Sentence[L]} {whoSentence: () => Sentence[L] / Who[L]} {traceSentence: () => Sentence[L] / Trace[L]}: Sentence[L] = {
  (whoBoundary[L]{whoSentence} {traceSentence}){answer}
}



// For fronted Who[L]
def who(): Sentence[Ls] / {Who[Ls]} = do who[Ls]()
def __(): Sentence[Ls] / {Trace[Ls]} = do trace[Ls]()
def whose(): Sentence[Ls] / {Who[Ls]} = who() 

// For In-Situ Who[L]
def who(): Sentence[Ls] / {Trace[Ls]} = do trace[Ls]()


// ---- Examples that Work ----

def WhoDidAliceSee(): {() => Sentence[Ls]} => Sentence[Ls] at {} = whoBoundary {who()} {alice.saw(__())}
val aliceSawBob = (WhoDidAliceSee()){() => bob}

// Who[L] can pied-pipe surrounding words
def whoseMotherDoesAliceLove(): {() => Sentence[Ls]} => Sentence[Ls] at {} = whoBoundary {who().mother()} {alice.loves(__())} 
val AliceLovesBobsMother = (whoseMotherDoesAliceLove()){() => bob}

def whoSawHisMother(): Sentence[Ls] = ioBoundary {
  whoBoundary {bind[Ls](who())} {__().saw(his().mother())} {() => bob}
}

// Could bind to who[L] or Father
def whoseFatherDidAliceSaySawHisMother(): Sentence[Ls] = ioBoundary {
  whoBoundary {bind[Ls](father(who()))} {__().saw(his().mother())} {() => bob}
}

// Correctly doesn't connect who[L] with his
def whoDidHisMotherSee(): Sentence[Ls] = ioBoundary { 
  whoBoundary {bind[Ls](who())} {his().mother().saw( __())} {() => bob}
}

// Could be better with Multiple Levels
def whoSawWho(): Sentence[Ls] = whoBoundary {who()} {__().saw(who())} {() => bob}

// To use IO in incomplete Sentences, boxing is necessary
def whoLoveshisMother(): {() => Sentence[Ls]} => Sentence[Ls] / {IO[Ls]} at {} = box { {arg} => whoBoundary{who()} {loves(__(), his().mother)} {arg} }
def bobLovesHisMother(): Sentence[Ls] = ioBoundary { (whoLoveshisMother()){() => bind[Ls](bob)}}


// ---- Examples that don't work ----

// Since In-Situ-Who[L] and Trace[L] are implemented the same, Superiority doesn't work correctly
def whoDidWhoSee__(): Sentence[Ls] = whoBoundary {who()} {who().saw(__())} {() => bob}

// Doesn't work, because who[L] can't select out of a set of people, interesting because john can bind he
def whichOfJohnsFriendsdoesHeLike__(): Sentence[Ls] = <>

def main() = {
  println("a")
}