module inputOutput

import src/sentence


interface Input[L] {
  def input(): Sentence[L]
}

interface Output[L]{
  def output(a: Sentence[L]): Sentence[L]
}
  
effect IO[L] = {Input[L], Output[L]} 

def inputBoundary[L]{body: () => Sentence[L] / {Input[L]}}: Sentence[L] => Sentence[L] at {body} = box { a =>
  try {
      body()
  } with Input[L] {
    def input() = resume(a)
  }
}

def ioBoundary[L]{body: {Input[L]} {Output[L]} => Sentence[L] / {Input[L], Output[L]}}: Sentence[L] = {
  var cache = Empty()
  try {
    body{capInput} {capOutput}
  } with capInput: Input[L] {
    def input() = {
      resume(cache)
    }
  } with capOutput: Output[L] {
    def output(s) = {
      cache = s
      resume(s)
    }
  }
}

def ioBoundary[L]() { body: => Sentence[L] / {Input[L], Output[L]}}: Sentence[L] = {
  ioBoundary[L]{ {_} {_} => body()}
}


// Helper Definitions
def he[L](): Sentence[L] / {Input[L]} = do input()
def he() = he[Ls]()
def she() = he()
def him() = he()
def her() = he()
def his() = he()
def bind[L](s: Sentence[L]): Sentence[L] / {Output[L]} = do output(s)
def bind(s: Sentence[Ls]) = bind[Ls](s)


// --- Examples that work ---

val bobLovesHisMother = ioBoundary[Ls] {
  bind[Ls](bob).loves(his().mother)
} 

val BobSaysHeLovesHisMother = ioBoundary[Ls] {
  bind[Ls](bob).says(he[Ls]().loves(his().mother))
} 

val HeLovesBobsMother = ioBoundary[Ls] {
  he[Ls]().loves(bind[Ls](bob).mother())
} 

val BobSaysAliceSaysSheLovesHisMother = ioBoundary[Ls] { {inputOuter} {outputOuter} =>
  ioBoundary { {inputInner} {outputInner} =>
    says(outputOuter.output(bob), outputInner.output(alice).says(inputInner.input().loves(inputOuter.input().mother())))
  }
} 

def herMother(): Sentence[Ls] => Sentence[Ls] at {} = inputBoundary {
  her().mother()
} 


