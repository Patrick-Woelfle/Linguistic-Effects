module inputOutput

import src/sentence


interface Input {
  def input(): Sentence
}

interface Output{
  def output(a: Sentence): Sentence
}

effect IO = {Input, Output} 

def inputBoundary{body: () => Sentence / {Input}}: Sentence => Sentence at {body} = box { a =>
  try {
      body()
  } with Input {
    def input() = resume(a)
  }
}

def ioBoundary{body: {Input} {Output} => Sentence / {Input, Output}}: Sentence = {
  var cache = Empty()
  try {
    body{capInput} {capOutput}
  } with capInput: Input {
    def input() = {
      resume(cache)
    }
  } with capOutput: Output {
    def output(s) = {
      cache = s
      resume(s)
    }
  }
}

def ioBoundary() { body: => Sentence / {Input, Output}}: Sentence = {
  ioBoundary{ {_} {_} => body()}
}


// Helper Definitions
def he(): Sentence / {Input} = do input()
def she() = he()
def him() = he()
def her() = he()
def his() = he()
def bind(s: Sentence): Sentence / {Output} = do output(s)


// --- Examples that work ---

val bobLovesHisMother = ioBoundary {
  bind(bob).loves(his().mother)
} 

val BobSaysHeLovesHisMother = ioBoundary {
  bind(bob).says(he().loves(his().mother))
} 

val HeLovesBobsMother = ioBoundary {
  he().loves(bind(bob).mother())
} 

val BobSaysAliceSaysSheLovesHisMother = ioBoundary { {inputOuter} {outputOuter} =>
  ioBoundary { {inputInner} {outputInner} =>
    says(outputOuter.output(bob), outputInner.output(alice).says(inputInner.input().loves(inputOuter.input().mother())))
  }
} 

def herMother(): Sentence => Sentence at {} = inputBoundary {
  her().Mother()
} 

