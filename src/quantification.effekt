module quantification

import src/sentence
import src/inputOutput
import src/traceWho


interface Quantification[L] {
  // Corresponds to every/a ___
  def every(s: Sentence[Ls]): Sentence[Ls]
  def a(s: Sentence[Ls]): Sentence[Ls]
  // Corresponds to everyone/someone
  def everyone(): Sentence[L]
  def someone(): Sentence[L]
}

def quantificationBoundary(personLabel: String) { body: {Quantification[Ls]} => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  var counter = 0
  def fresh(): Sentence[Ls] = { val x = identifier(personLabel ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification[Ls] {
    def everyone() = {
      val x = fresh()
      forall(x, resume(x))
    }
    def every(s: Sentence[Ls]) = {
      val x = fresh()
      forall(x, implies(is_(x, s), resume(x)))
    }
    def a(s: Sentence[Ls]) = {
      val x = fresh()
      exists(x, andP(is_(x, s), resume(x)))
    }
    def someone() = {
      val x = fresh()
      exists(x, resume(x))
    }
  }
}

// Overload for multible levels
def quantificationBoundary { body: => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  quantificationBoundary{ {_} => body()}
}

def quantificationBoundary { body: {Quantification[Ls]} => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  quantificationBoundary("x"){body}
}


// Helper Definitions
def everyone(): Sentence[Ls] / {Quantification[Ls]} = do everyone()
def someone(): Sentence[Ls] / {Quantification[Ls]} = do someone()
def a(s: Sentence[Ls]): Sentence[Ls] / {Quantification[Ls]} = do a(s)
def every(s: Sentence[Ls]): Sentence[Ls] / {Quantification[Ls]} = do every(s)

val aStudentLikesEveryBook: Sentence[Ls] = 
  quantificationBoundary {
    a(woman()).likes(every(man()))
} 

def main() = {
  println(show(aStudentLikesEveryBook))
}