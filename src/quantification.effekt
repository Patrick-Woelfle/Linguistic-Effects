module quantification

import src/sentence
import src/inputOutput
import src/traceWho
import src/implicature


interface Quantification[L] {
  // Corresponds to every/a ___
  def every(predicate: Sentence[L]): Sentence[L]
  def a(predicate: Sentence[L]): Sentence[L]
  // Corresponds to everyone/someone
  def everyone(): Sentence[L]
  def someone(): Sentence[L]
}

def quantificationBoundary(personLabel: String) { body: {Quantification[Ls]} => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  var counter = 0
  def fresh(): Sentence[Ls] = { val x = identifier(personLabel ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification[Ls] {
    def everyone() = {
      val x = fresh()
      forall(x, resume(x))
    }
    def every(predicate) = {
      val x = fresh()
      forall(x, implies(combine(x, predicate), resume(x)))
    }
    def a(predicate) = {
      val x = fresh()
      exists(x, andP(combine(x, predicate), resume(x)))
    }
    def someone() = {
      val x = fresh()
      exists(x, resume(x))
    }
  }
}

// Overload for multible levels
def quantificationBoundary { body: => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  quantificationBoundary{ {_} => body()}
}

def quantificationBoundary { body: {Quantification[Ls]} => Sentence[Ls] / Quantification[Ls]}: Sentence[Ls] = {
  quantificationBoundary("x"){body}
}


// Helper Definitions
def everyone(): Sentence[Ls] / {Quantification[Ls]} = do everyone()
def someone(): Sentence[Ls] / {Quantification[Ls]} = do someone()
def a(predicate: Sentence[Ls]) = do a(predicate)
def every(predicate: Sentence[Ls]) = do every(predicate)


// --- Examples that work ---

val aliceLovesEveryonesMother: Sentence[Ls] = quantificationBoundary{
  alice.loves(everyone().mother())
}

// Combination with IO
val everyonesFatherLovesTheirMother: Sentence[Ls] = ioBoundary[Ls] {
  quantificationBoundary {
    father(bind(everyone())).loves(mother(do input()))
  }
}

// Correctly doesn't connect her and Everyone
val herFatherLovesEveryonesMother: Sentence[Ls] = ioBoundary {
  quantificationBoundary {
    father(do input()).loves(mother(bind(everyone())))
  }
}

def whosePresentforhimDideveryonesFatherSee{answer: () => Sentence[Ls]}: Sentence[Ls] = quantificationBoundary {
  ioBoundary[Ls] {
    whoBoundary[Ls] {do who[Ls]().present(he())} {bind(father(everyone())).saw(__())} {answer()}
  }
}

def whosePresentforhimDideveryonesFatherSee{answer: () => Sentence[Ls]}: Sentence[Ls] = quantificationBoundary {
  ioBoundary[Ls] {
    whoBoundary[Ls] {who().present(he())} {bind(father(everyone())).saw(__())} {answer}
  }
}

// Uses multiple levels
val someoneLovesEveryone: Sentence[Ls] = quantificationBoundary("x"){ {outer} =>  
  quantificationBoundary("y") { {inner} =>
      inner.someone().loves(outer.everyone)
  }
}

