module quantification

import src/sentence
import src/questions


interface Quantification[L] {
  // Corresponds to every/a ___
  def every(s: S[Ls]): S[Ls]
  def a(s: S[Ls]): S[Ls]
  // Corresponds to everyone/someone
  def everyone(): S[L]
  def someone(): S[L]
}

def quantification(personLabel: String) { body: {Quantification[Ls]} => S[Ls] / Quantification[Ls]}: S[Ls] = {
  var counter = 0
  def fresh(): S[Ls] = { val x = identifier(personLabel ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification[Ls] {
    def everyone() = {
      val x = fresh()
      forall(x, resume(x))
    }
    def every(s: S[Ls]) = {
      val x = fresh()
      forall(x, implies(is_(x, s), resume(x)))
    }
    def a(s: S[Ls]) = {
      val x = fresh()
      exists(x, andP(is_(x, s), resume(x)))
    }
    def someone() = {
      val x = fresh()
      exists(x, resume(x))
    }
  }
}

// Overload for multible levels
def quantification { body: => S[Ls] / Quantification[Ls]}: S[Ls] = {
  quantification{ {_} => body()}
}

def quantification { body: {Quantification[Ls]} => S[Ls] / Quantification[Ls]}: S[Ls] = {
  quantification("x"){body}
}


// Helper Definitions
def everyone(): S[Ls] / {Quantification[Ls]} = do everyone()
def someone(): S[Ls] / {Quantification[Ls]} = do someone()
def a(s: S[Ls]): S[Ls] / {Quantification[Ls]} = do a(s)
def every(s: S[Ls]): S[Ls] / {Quantification[Ls]} = do every(s)

val aStudentLikesEveryBook: S[Ls] = 
  quantification {
    a(woman()).likes(every(man()))
} 

def main() = {
  println(show(aStudentLikesEveryBook))
}