module quantification

import src/sentence
import src/inputOutput
import src/traceWho


interface Quantification {
  // Corresponds to every/a ___
  def every(predicate: Sentence): Sentence
  def a(predicate: Sentence): Sentence
  // Corresponds to everyone/someone
  def everyone(): Sentence
  def someone(): Sentence
}

def quantificationBoundary(personLabel: String) { body: {Quantification} => Sentence / Quantification}: Sentence = {
  var counter = 0
  def fresh(): Sentence = { val x = Person(personLabel ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification {
    def everyone() = {
      val x = fresh()
      ForAll(x, resume(x))
    }
    def every(predicate) = {
      val x = fresh()
      ForAll(x, Implies(Is(x, predicate), resume(x)))
    }
    def a(predicate) = {
      val x = fresh()
      And(And(Exists(x), Is(x, predicate)), resume(x))
    }
    def someone() = {
      val x = fresh()
      And(Exists(x), resume(x))
    }
  }
}

// Overload for multible levels
def quantificationBoundary { body: => Sentence / Quantification}: Sentence = {
  quantificationBoundary{ {_} => body()}
}

def quantificationBoundary { body: {Quantification} => Sentence / Quantification}: Sentence = {
  quantificationBoundary("x"){body}
}


// Helper Definitions
def everyone() = do everyone()
def someone() = do someone()
def a(predicate: Sentence) = do a(predicate)
def every(predicate: Sentence) = do every(predicate)


// --- Examples that work ---

val aliceLovesEveryonesMother: Sentence = quantificationBoundary{
  alice.loves(everyone().mother())
}

// Combination with IO
val everyonesFatherLovesTheirMother: Sentence = ioBoundary {
  quantificationBoundary {
    Father(bind(everyone())).loves(Mother(do input()))
  }
}

// Correctly doesn't connect her and Everyone
val herFatherLovesEveryonesMother: Sentence = ioBoundary {
  quantificationBoundary {
    Father(do input()).loves(Mother(bind(everyone())))
  }
}

def whosePresentforhimDideveryonesFatherSee{answer: () => Sentence}: Sentence = quantificationBoundary {
  ioBoundary {
    whoBoundary {who().present(him())} {bind(Father(everyone())).saw(__())} {answer}
  }
}

// Uses multiple levels
val someoneLovesEveryone: Sentence = quantificationBoundary("x"){ {outer} =>  
  quantificationBoundary("y") { {inner} =>
      inner.someone().loves(outer.everyone)
  }
}


def main(): Unit = {
  println(show(someoneLovesEveryone))
}