module src/test

import test
import src/sentence
import src/anaphora
import src/traceWho
import src/quantification
import src/parse
import src/directSpeach


def main() = {
  mainSuite("Tests") {
    // --------------- IO ---------------
    test("Simple Pronoun Binding") {
      assert( 
          parse([Bob(), Loves(), His(), Mother()]).show(), 
          bob().loves(bob().mother()).show()
      )
    }
    test("Douple Pronoun Binding") {
      assert( 
          parse([Bob(), Says(), He(), Loves(), His(), Mother()]).show(), 
          bob().says(bob().loves(bob().mother)).show()
      )
    }
    test("Pronoun Usage before binding") {
      assert( 
          parse([He(), Loves(), Bob(), Mother()]).show(), 
          Unknown().loves(bob().mother()).show()
      )
    }
    test("Input Output over multiple Levels") {
      assert( 
        anaphora[Ls] { {getOuter} {setOuter} =>
          anaphora[Ls] { {getInner} {setInner} =>
            setOuter.set(bob()).says(setInner.set(alice()).says(getInner.get().loves(getOuter.get().mother())))
          }
        }.show(), 
        bob().says(alice().says(alice().loves(bob().mother()))).show()
      )
    }
    test("Input without Output") {
      def herMother(): S[Ls] => S[Ls] at {} = getBoundary {
        her().mother()
      }
      assert(herMother()(alice()).show(), alice().mother().show())
    }
    // --------------- Trace Who ---------------
    test("Trace Boundary Normal") {
      def aliceLoves___(): {() => S[Ls]} => S[Ls] at {} = traceBoundary {loves(alice(), __())}
      val aliceLovesBob: S[Ls] = (aliceLoves___()){() => bob()}
      assert(aliceLovesBob.show(), alice().loves(bob()).show())
    }
    test("Trace Boundary Overloaded") {
      def aliceLoves___{answer: () => S[Ls]}: S[Ls] = traceBoundary {loves(alice(), __())} {answer}
      val aliceLovesBob: S[Ls] = aliceLoves___{() => bob()}
      assert(aliceLovesBob.show(), alice().loves(bob()).show())
    }
    test("Who Boundary") {
      def WhoDidAliceSee(): {() => S[Ls]} => S[Ls] at {} = whoBoundary {do who()} {alice().saw(__())}
      val aliceSawBob = (WhoDidAliceSee()){() => bob()}
      assert(aliceSawBob.show(), alice().saw(bob()).show())
    }
    test("Pied Piping") {
      def whoseMotherDoesAliceLove(): {() => S[Ls]} => S[Ls] at {} = whoBoundary {do who().mother()} {alice().loves(__())} 
      val aliceLovesBobsMother: S[Ls] = (whoseMotherDoesAliceLove()){() => bob()}
      assert(aliceLovesBobsMother.show(), alice().loves(bob().mother).show())
    }
    // --------------- Quantification ---------------
    test("Simple Quantification") {
      assert(parse([Alice(), Loves(), Everyone(), Mother()]).show(), forall(identifier("x0"), alice().loves(identifier("x0").mother())).show())
    }
    test("Other types of quantification") {
      val aliceLovesAWoman: S[Ls] = quantificationBoundary {
        alice().loves(a(woman()))
      }
      assert(aliceLovesAWoman.show(), exists(identifier("x0"), andP(is_(identifier("x0"), woman()), alice().loves(identifier("x0")))).show())
      val everyWomanLovesAMan: S[Ls] = quantificationBoundary {
        every(woman()).loves(a(man()))
      }
      assert(everyWomanLovesAMan.show(), forall(identifier("x0"), is_(identifier("x0"), woman()).implies(exists(identifier("x1"), andP(is_(identifier("x1"), man()), identifier("x0").loves(identifier("x1")))))).show())
    }
    test("Multiple Levels of Quantification") {
      val someoneLovesEveryone: S[Ls] = quantificationBoundary("x"){ {outer} =>  
        quantificationBoundary("y") { {inner} =>
            inner.someone().loves(outer.everyone)
        }
      }
      assert(someoneLovesEveryone.show(), forall(identifier("x0"), exists(identifier("y0"), identifier("y0").loves(identifier("x0")))).show())
    }
    // --------------- directSpeach ---------------
    test("Simple direct speach") {
      val johnSaidBobLovesMe: S[Ls] = john().said{bob().loves(me())}
      assert(johnSaidBobLovesMe.show(), john().says(bob().loves(john())).show())
    }
    // --------------- Interactions ---------------
    test("Interaction Trace Boundary, Input Output") {
      val bobLovesHisMother: S[Ls] = anaphora {
        traceBoundary {loves(__(), his().mother)} {bind(bob())}
      }
      assert(bobLovesHisMother.show(), bob().loves(bob().mother).show())
      val herMotherLovesAlice: S[Ls] = anaphora {
        traceBoundary {loves(mother(her()), __())} {bind(alice())}
      }
      assert(herMotherLovesAlice.show(), Unknown().mother.loves(alice()).show())
    }
    test("Interaction Input Output, Quantification") {
      val everyonesFatherLovesTheirMother: S[Ls] = anaphora[Ls] {
        quantificationBoundary {
          father(bind(everyone())).loves(mother(do get()))
        }
      }
      assert(everyonesFatherLovesTheirMother.show(), forall(identifier("x0"), identifier("x0").father().loves(identifier("x0").mother())).show())
    }
    test("Interaction Input Output, Direct Speach") {
      val johnLikesHeSaidBobLovesMe = anaphora[Ls] {
        bind(john()).loves(he().said{bob().loves(me())})
      }
      assert(show(johnLikesHeSaidBobLovesMe), show(john().loves(john().says(bob().loves(john())))))
    }
    test("Interaction Quantification, Direct Speach") {
      val everyoneSaidBobLovesMe = quantificationBoundary {
        everyone().said{bob().loves(me())}
      }
      assert(show(everyoneSaidBobLovesMe), show(forall(identifier("x0"), identifier("x0").says(bob().loves(identifier("x0"))))))
    }
    test("Interaction Input Output, Quantification, Questions") {
      def whosePresentforhimDideveryonesFatherSee{answer: () => S[Ls]}: S[Ls] = quantificationBoundary {
        anaphora[Ls] {
          (whoBoundary {do who().present(he())} {bind(father(everyone())).saw(__())}) {answer()}
        }
      }
      val everyonesFatherSawBobsPresentForHim = show(whosePresentforhimDideveryonesFatherSee{() => bob()})
      val denotationEveryonesFatherSawBobsPresentForHim = show(forall(identifier("x0"), identifier("x0").father().saw(bob().present(identifier("x0").father()))))
      assert(everyonesFatherSawBobsPresentForHim, denotationEveryonesFatherSawBobsPresentForHim)
      def whoseMotherLovesHisFather{answer: () => S[Ls] / {Quantification[Ls], Set[Ls]}}: S[Ls] = quantificationBoundary {
        anaphora[Ls] {
          (whoBoundary {do who().mother()} {__().loves(his().father())}) {answer()}
        }
      }
      val everyonesMotherLovesTheirFather = show(whoseMotherLovesHisFather{() => bind(everyone())})
      assert(everyonesMotherLovesTheirFather, show(forall(identifier("x0"), identifier("x0").mother().loves(identifier("x0").father()))))
    }
  }
}