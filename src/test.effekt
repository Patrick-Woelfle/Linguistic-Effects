module src/test

import test
import src/sentence
import src/inputOutput
import src/traceWho
import src/quantification
import src/implicature



def main() = {
  mainSuite("Tests") {
    // --------------- IO ---------------
    test("Simple Pronoun Binding") {
      assert( 
          ioBoundary[Ls] { 
            bind(bob).loves(his().mother())
          }.show(), 
          bob.loves(bob.mother()).show()
      )
    }
    test("Douple Pronoun Binding") {
      assert( 
          ioBoundary[Ls] { 
            bind(bob).says(he().loves(his().mother))
          }.show(), 
          bob.says(bob.loves(bob.mother)).show()
      )
    }
    test("Pronoun Usage before binding") {
      assert( 
          ioBoundary[Ls] { 
            he().loves(bind(bob).mother())
          }.show(), 
          Empty().loves(bob.mother()).show()
      )
    }
    test("Input Output over multiple Levels") {
      assert( 
        ioBoundary[Ls] { {inputOuter} {outputOuter} =>
          ioBoundary[Ls] { {inputInner} {outputInner} =>
            outputOuter.output(bob).says(outputInner.output(alice).says(inputInner.input().loves(inputOuter.input().mother())))
          }
        }.show(), 
        bob.says(alice.says(alice.loves(bob.mother()))).show()
      )
    }
    test("Input without Output") {
      def herMother(): Sentence[Ls] => Sentence[Ls] at {} = inputBoundary {
        her().mother()
      }
      assert(herMother()(alice).show(), alice.mother().show())
    }
    // --------------- Trace Who ---------------
    test("Trace Boundary Normal") {
      def aliceLoves___(): {() => Sentence[Ls]} => Sentence[Ls] at {} = traceBoundary {loves(alice, __())}
      val aliceLovesBob: Sentence[Ls] = (aliceLoves___()){() => bob}
      assert(aliceLovesBob.show(), alice.loves(bob).show())
    }
    test("Trace Boundary Overloaded") {
      def aliceLoves___{answer: () => Sentence[Ls]}: Sentence[Ls] = traceBoundary {loves(alice, __())} {answer}
      val aliceLovesBob: Sentence[Ls] = aliceLoves___{() => bob}
      assert(aliceLovesBob.show(), alice.loves(bob).show())
    }
    test("Who Boundary") {
      def WhoDidAliceSee(): {() => Sentence[Ls]} => Sentence[Ls] at {} = whoBoundary {do who()} {alice.saw(__())}
      val aliceSawBob = (WhoDidAliceSee()){() => bob}
      assert(aliceSawBob.show(), alice.saw(bob).show())
    }
    test("Pied Piping") {
      def whoseMotherDoesAliceLove(): {() => Sentence[Ls]} => Sentence[Ls] at {} = whoBoundary {do who().mother()} {alice.loves(__())} 
      val aliceLovesBobsMother: Sentence[Ls] = (whoseMotherDoesAliceLove()){() => bob}
      assert(aliceLovesBobsMother.show(), alice.loves(bob.mother).show())
    }
    // --------------- Quantification ---------------
    test("Simple Quantification") {
      val aliceLovesEveryonesMother: Sentence[Ls] = quantificationBoundary{
        alice.loves(everyone().mother())
      }
      assert(aliceLovesEveryonesMother.show(), forall(identifier("x0"), alice.loves(identifier("x0").mother())).show())
    }
    test("Multiple Levels of Quantification") {
      val someoneLovesEveryone: Sentence[Ls] = quantificationBoundary("x"){ {outer} =>  
        quantificationBoundary("y") { {inner} =>
            inner.someone().loves(outer.everyone)
        }
      }
      assert(someoneLovesEveryone.show(), forall(identifier("x0"), exists(identifier("y0"), identifier("y0").loves(identifier("x0")))).show())
    }
    // --------------- Implicature ---------------
    // Todo
    
    // --------------- Interactions ---------------
    test("Interaction Trace Boundary, Input Output") {
      val bobLovesHisMother: Sentence[Ls] = ioBoundary {
        traceBoundary {loves(__(), his().mother)} {bind(bob)}
      }
      assert(bobLovesHisMother.show(), bob.loves(bob.mother).show())
      val herMotherLovesAlice: Sentence[Ls] = ioBoundary {
        traceBoundary {loves(mother(her()), __())} {bind(alice)}
      }
      assert(herMotherLovesAlice.show(), Empty().mother.loves(alice).show())
    }
    test("Interaction Input Output, Quantification") {
      val everyonesFatherLovesTheirMother: Sentence[Ls] = ioBoundary[Ls] {
        quantificationBoundary {
          father(bind(everyone())).loves(mother(do input()))
        }
      }
      assert(everyonesFatherLovesTheirMother.show(), forall(identifier("x0"), identifier("x0").father().loves(identifier("x0").mother())).show())
      val herFatherLovesEveryonesMother: Sentence[Ls] = ioBoundary {
        quantificationBoundary {
          father(do input()).loves(mother(bind(everyone())))
        }
      }
      assert(herFatherLovesEveryonesMother.show(), forall(identifier("x0"), Empty().father().loves(identifier("x0").mother())).show())
      def whosePresentforhimDideveryonesFatherSee{answer: () => Sentence[Ls]}: Sentence[Ls] = quantificationBoundary {
        ioBoundary[Ls] {
          (whoBoundary {do who().present(he())} {bind(father(everyone())).saw(__())}) {answer()}
        }
      }
      def everyonesFatherSawBobsPresentForHim() = whosePresentforhimDideveryonesFatherSee{() => bob}
      // assert(everyonesFatherSawBobsPresentForHim().show(), show(forall(identifier("x0"), identifier("x0").father().saw(present(bob)))))
    }
  }
}