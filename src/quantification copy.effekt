module quantification

import src/sentence
import src/inputOutput
import src/traceWho


interface Quantification {
  // Corresponds to every/a ___
  def every(predicate: Sentence): Sentence
  def a(predicate: Sentence): Sentence
  // Corresponds to everyone/someone
  def everyone(): Sentence
  def someone(): Sentence
}

def quantificationBoundary { body: {Quantification} => Sentence}: Sentence = {
  var counter = 0
  def fresh(): Sentence = { val x = Person("x" ++ show(counter)); counter = counter + 1; x }
  try { body{cap} } with cap: Quantification {
    def everyone() = {
      val x = fresh()
      ForAll(x, resume(x))
    }
    def every(predicate) = {
      val x = fresh()
      ForAll(x, Implies(Is(x, predicate), resume(x)))
    }
    def a(predicate) = {
      val x = fresh()
      Exists(x, Implies(Is(x, predicate), resume(x)))
    }
    def someone() = {
      val x = fresh()
      Exists(x, resume(x))
    }
  }
}

def quantificationBoundary2 { body: => Sentence}: Sentence = {
  quantificationBoundary { {cap2} => body()}
}


// Helper Definitions
def everyone() = do everyone()
def someone() = do someone()
def a(predicate: Sentence) = do a(predicate)
def every(predicate: Sentence) = do every(predicate)


// --- Examples that work ---

val aliceLovesEveryonesMother: Sentence = quantificationBoundary2{ 
  alice.loves(mother(bob))
}



