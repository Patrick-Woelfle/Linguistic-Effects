module presentation

import src/sentence

interface Input {
  def input(): Sentence
}

interface Output{
  def output(a: Sentence): Sentence
}

def ioBoundary{body: () => Sentence / {Input, Output}}: Sentence = {
  var cache = Empty()
  try {
    body()
  } with Input {
    def input() = {
      resume(cache)
    }
  } with Output {
    def output(s) = {
      cache = s
      resume(s)
    }
  }
}

def his(): Sentence / {Input} = do input()

val bobLovesHisMother = ioBoundary {
  bob.loves(his().mother)
}

def main(): Unit = {
  println(show(bobLovesHisMother))
}