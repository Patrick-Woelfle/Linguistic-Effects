module parse

import src/sentence
import src/anaphora
import src/quantification
import src/traceWho
import src/prettyPrinter
import src/helperFunctions


interface Flip {
  def flip(): Bool
}

interface Split {
  def split(first: S[Ls], tail: List[Ls]): S[Ls]
}

effect ParseEffekts = {Split} 

def parseAllOptions(input: List[Ls]): List[S[Ls]] = {
  val allDenotations = evokeEffectsEntry(labelToSentenceEntry(input), true)
  val denotationsWithoutDuplicates = allDenotations.filterDuplicates()
  denotationsWithoutDuplicates.filter{sentenceDoesntContainEmpty}
}

def parse(input: List[Ls]): S[Ls] = {
  headOption(evokeEffectsEntry(labelToSentenceEntry(input), false)) match {
    case Some(a) => a
    case None() => Unknown()
  }
}

def labelToSentenceEntry(input: List[Ls]): S[Ls] = {
 try {
    labelToSentence(input, Unknown())
  } with Split { // Used, when two Term0s appear after another
    def split(arg: S[Ls], tail: List[Ls]) = {
      Prop2(And(), resume(arg), labelToSentenceEntry(tail))
    }
  }
}

def evokeEffectsEntry(input: S[Ls], allOptions: Bool): List[S[Ls]] = {
  try {
    [anaphora[Ls] {
      quantificationBoundary{
        evokeEffects(input)
      }
    }]
  } with Who {
    def who() = {
      println("Parsing failed, unexpected who found")
      [Unknown()]
    }
  } with Flip {
    def flip() = {
      if (allOptions) {
        resume(false).append(resume(true))
      } else resume(true)
    }
  }
}


def labelToSentence(input: List[Ls], arg: S[Ls]): S[Ls] / {ParseEffekts} ={
  input match {
    case Cons(front, tail) => front match {
      case Loves() => loves(arg, labelToSentence(tail, Unknown()))
      case Says() => says(arg, labelToSentence(tail, Unknown()))
      case Saw() => saw(arg, labelToSentence(tail, Unknown()))
      case Alice() => parseTerm0(Alice(), tail, arg)
      case Bob() => parseTerm0(Bob(), tail, arg)
      case Mother() => labelToSentence(tail, mother(arg))
      case He() => labelToSentence(tail, Term0(Pronoun()))
      case She() => labelToSentence(tail, Term0(Pronoun()))
      case Her() => labelToSentence(tail, Term0(Pronoun()))
      case His() => labelToSentence(tail, Term0(Pronoun()))
      case Someone() => labelToSentence(tail, Term0(Someone()))
      case Everyone() => labelToSentence(tail, Term0(Everyone()))
      case Trace() => labelToSentence(tail, Term0(Trace()))
      case True() => parseProp0(True(), tail, arg)
      case False() => parseProp0(False(), tail, arg)
      case Who() => try { 
        labelToSentence(tail, Term0(Who()))
      } with Split {
        def split(whPhrase: S[Ls], tail: List[Ls]) = {
          Question1(whPhrase, labelToSentence(tail, Unknown()))
        }
      }
      case other => Term0(Identifier("Found something unexpected: " ++ show(other)))
    }
    case Nil() => arg
  }
}

def parseTerm0(front: Ls, tail: List[Ls], arg: S[Ls]): S[Ls] / {ParseEffekts} = {
  arg match {
    case Unknown() => labelToSentence(tail, Term0(front))
    case _ => do split(arg, Cons(front, tail))
  }
}

def parseProp0(front: Ls, tail: List[Ls], arg: S[Ls]): S[Ls] / {ParseEffekts} = {
  arg match {
    case Unknown() => labelToSentence(tail, Prop0(front))
    case _ => do split(arg, Cons(front, tail))
  }
}

def evokeEffects(input: S[Ls]): S[Ls] / {Anaphora[Ls], Quantification[Ls], Who, Flip} = {
  input match {
    case Prop3(label, arg1, arg2, arg3) => Prop3(label, evokeEffects(arg1), evokeEffects(arg2), evokeEffects(arg3))
    case Prop2(label, arg1, arg2) => Prop2(label, evokeEffects(arg1), evokeEffects(arg2))
    case Prop1(label, arg1) => Prop1(label, evokeEffects(arg1))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => 
      if (do flip()) {
        do set(Term3(label, evokeEffects(arg1), evokeEffects(arg2), evokeEffects(arg3)))
      } else {
        Term3(label, evokeEffects(arg1), evokeEffects(arg2), evokeEffects(arg3))
      }
    case Term2(label, arg1, arg2) => 
      if (do flip()) {
        do set(Term2(label, evokeEffects(arg1), evokeEffects(arg2)))
      } else {
        Term2(label, evokeEffects(arg1), evokeEffects(arg2))
      }
    case Term1(label, arg1) => 
      if (do flip()) {
        do set(Term1(label, evokeEffects(arg1)))
      } else {
        Term1(label, evokeEffects(arg1))
      }
    case Term0(label ) => label match {
          case Pronoun() => 
            do get()
          case Someone() => 
            if (do flip()) {
              do set(do someone())
            } else {
              do someone()
            }
          case Everyone() =>
            if (do flip()) {
              do set(do everyone())
            } else {
              do everyone()
            }
          case _ => 
            if (do flip()) {
              do set(input)
            } else {
              input
            }
        }
    case Question1(whPhrase, question) => Question2(whoBoundary{() => whPhrase}{() => question})
    case Question2(question) => input
    case Quantifier(label, arg1, arg2) => (Quantifier(label, evokeEffects(arg1), evokeEffects(arg2)))
    case Unknown() => Unknown()
  }
}


def test() = {
  parseAllOptions([Everyone(), Says(), Bob(), Loves(), His(), Mother()])
}

def main() = {
  println(sentenceToString(test()))
}

