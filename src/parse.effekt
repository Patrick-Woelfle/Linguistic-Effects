module parse

import src/sentence
import src/inputOutput
import src/quantification
import src/traceWho
import src/prettyPrinter

interface Flip {
  def flip(): Bool
}

interface Split {
  def split(first: Sentence[Ls], tail: List[Ls]): Sentence[Ls]
}

effect ParseEffekts = {Flip, Split} 

def parse(input: List[Ls]): Sentence[Ls] = {
    val intermidiatSentence = try {
      labelToSentence(input, Empty())
    } with Flip { // Currently not used
      def flip() = {
        Prop2(Or(), resume(false), resume(true))
      }
    } with Split { // Used, when two Term0s appear after another
      def split(arg: Sentence[Ls], tail: List[Ls]) = {
        Prop2(And(), resume(arg), parse(tail))
      }
    }
  try {
    ioBoundary[Ls] {
      quantificationBoundary{
        evokeEffects(intermidiatSentence)
      }
    }
  }
  with Who {
    def who() = {
      println("Parsing failed: ")
      Empty()
    }
  }
}


// Ask about matching on multiple patterns
def labelToSentence(input: List[Ls], arg: Sentence[Ls]): Sentence[Ls] / {ParseEffekts} ={
  input match {
    case Cons(front, tail) => front match {
      case Loves() => loves(arg, labelToSentence(tail, Empty()))
      case Says() => says(arg, labelToSentence(tail, Empty()))
      case Alice() => parseTerm0(Alice(), tail, arg)
      case Bob() => parseTerm0(Bob(), tail, arg)
      case Mother() => labelToSentence(tail, mother(arg))
      case He() => labelToSentence(tail, Term0(Pronoun()))
      case She() => labelToSentence(tail, Term0(Pronoun()))
      case Her() => labelToSentence(tail, Term0(Pronoun()))
      case His() => labelToSentence(tail, Term0(Pronoun()))
      case Someone() => labelToSentence(tail, Term0(Someone()))
      case Everyone() => labelToSentence(tail, Term0(Everyone()))
      case Trace() => labelToSentence(tail, Term0(Trace()))
      case Who() => try { 
        labelToSentence(tail, Term0(Who()))
      } with Split {
        def split(whPhrase: Sentence[Ls], tail: List[Ls]) = {
          Question1(whPhrase, labelToSentence(tail, Empty()))
        }
      }
      case other => Term0(Identifier("Found something unexpected: " ++ show(other)))
    }
    case Nil() => arg
  }
}

def parseTerm0(front: Ls, tail: List[Ls], arg: Sentence[Ls]): Sentence[Ls] / {ParseEffekts} = {
  arg match {
    case Empty() => labelToSentence(tail, Term0(front))
    case _ => do split(arg, Cons(front, tail))
  }
}

def evokeEffects(input: Sentence[Ls]): Sentence[Ls] / {IO[Ls], Quantification[Ls], Who} = {
  input match {
    case Prop3(label, arg1, arg2, arg3) => Prop3(label, evokeEffects(arg1), evokeEffects(arg2), evokeEffects(arg3))
    case Prop2(label, arg1, arg2) => Prop2(label, evokeEffects(arg1), evokeEffects(arg2))
    case Prop1(label, arg1) => Prop1(label, evokeEffects(arg1))
    case Prop0(label) => Prop0(label)
    case Term3(label, arg1, arg2, arg3) => do output(Term3(label, evokeEffects(arg1), evokeEffects(arg2), evokeEffects(arg3)))
    case Term2(label, arg1, arg2) => do output(Term2(label, evokeEffects(arg1), evokeEffects(arg2)))
    case Term1(label, arg1) => do output(Term1(label, evokeEffects(arg1)))
    case Term0(label ) => label match {
          case Pronoun() => do input()
          case Someone() => do output(do someone())
          case Everyone() => do output(do everyone())
          case _ => do output(input)
        }
    case Question1(whPhrase, question) => Question2(whoBoundary{() => whPhrase}{() => question})
    case Question2(question) => input
    case Quantifier(label, arg1, arg2) => {
      do output(Quantifier(label, evokeEffects(arg1), evokeEffects(arg2)))
    }
    
    case Empty() => Empty()
  }
}



def test() = {
  parse([Bob(), Loves(), His(), Mother()])
}

def main() = {
  println(sentenceToString(test()))
}